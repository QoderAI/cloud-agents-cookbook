{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qoder.com/schemas/cookbook/redirects.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "redirects"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "redirects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "to": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
