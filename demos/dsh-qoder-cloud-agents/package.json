{
  "name": "dsh-qoder-cloud-agents",
  "description": "DeepSeek Harness plugin that runs sessions and delegated tasks on Qoder Cloud Agents sandboxes",
  "homepage": "https://github.com/QoderAI/cloud-agents-cookbook/tree/main/demos/dsh-qoder-cloud-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QoderAI/cloud-agents-cookbook.git",
    "directory": "demos/dsh-qoder-cloud-agents"
  },
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cloud-route": {
      "types": "./lib/types/cloud-route.d.ts",
      "default": "./lib/cloud-route.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/cloud-route.js",
    "/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qoder",
    "cloud-agents"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-0 <5",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0-0 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-commands": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.4",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-user-questions": "^0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2",
    "@types/node": "^22.10.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
