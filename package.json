{
  "name": "@qoderai/cloud-agents-cookbook",
  "version": "1.0.0",
  "private": true,
  "description": "Content contracts and validation tooling for Qoder Cloud Agents Cookbook",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build-catalog.mjs",
    "preview": "node scripts/build-preview.mjs",
    "links": "node scripts/check-links.mjs",
    "check": "npm test && npm run validate && npm run links && npm run build && npm run preview"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "gray-matter": "4.0.3",
    "jsdom": "26.1.0",
    "markdown-it": "14.3.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "^11.16.1",
    "yaml": "2.9.0"
  },
  "license": "SEE LICENSE IN LICENSE"
}
